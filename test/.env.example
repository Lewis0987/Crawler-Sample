# 複製本檔為 .env（或任意 *.env，例如 login123.env）後填入。
# .env / *.env 已被 .gitignore 排除，勿提交。
#
# 正式登入採「SM2 即時加密」：api_client 以 HMI_PASSWORD + SM2_PUBLIC_KEY 每次即時加密
# （對齊前端 sm-crypto doEncrypt cipherMode=1；最終 password = "04" + C1C3C2 hex，共 214 hex）。
#
# 安全：
#   - 不可提交真實密碼（HMI_PASSWORD）
#   - 不可提交任何 token（accessToken / refreshToken）
#   - 不可提交實際 login*.env（本檔 .env.example 僅為範例格式，不放真實值）

HMI_USERNAME=hmiUser
HMI_PASSWORD=

# 130 hex（04 開頭），前端 Pr() / Xn() 內的 SM2 public key。
# 注意：Network Payload 中的 214 hex password 是「密文」不是公鑰，勿貼進此欄。
SM2_PUBLIC_KEY=

# Deprecated：正式流程不使用，保持空白（程式已不讀取，僅為相容標註）。
LOGIN_PASSWORD_PAYLOAD=
